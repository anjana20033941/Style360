# Style360 Environment Configuration Example

# Database Configuration
DATABASE_URL=mysql://root:@localhost:3306/style360_v2
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=style360_v2
DB_USERNAME=root
DB_PASSWORD=

# Gemini & HF API Keys
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
HF_API_TOKEN=your_hf_token
HF_TRYON_SPACE=yisol/IDM-VTON

# Fal.ai & Tripo3D Keys
FAL_KEY=your_fal_key
TRIPO_API_KEY=your_tripo_key

# Replicate API
REPLICATE_API_TOKEN=your_replicate_token
REPLICATE_MODEL_RODIN=deemos/rodin

# Modal.com Pipeline Endpoints
USE_MODAL=true
MODAL_PIPELINE_URL=https://your-modal-pipeline.modal.run
MODAL_SF3D_URL=https://your-modal-sf3d.modal.run
MODAL_HEALTH_URL=https://your-modal-health.modal.run
MODAL_MULTIVIEW_URL=https://your-modal-multiview.modal.run
MODAL_DEBUG_PREVIEW_URL=https://your-modal-debug.modal.run
MODAL_TRELLIS_URL=https://your-modal-trellis.modal.run
MODAL_HUNYUAN3D_URL=https://your-modal-hunyuan.modal.run

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_ENABLED=true
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=style360-assets
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev
